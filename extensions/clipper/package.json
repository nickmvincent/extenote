{
  "name": "@extenote/clipper",
  "version": "0.3.0",
  "description": "Extenote Web Clipper browser extension",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run build.ts",
    "build:chrome": "bun run build.ts --chrome",
    "watch": "bun run build.ts --watch",
    "clean": "rm -rf dist/* dist-chrome/*",
    "test": "bun test",
    "web-ext:run": "web-ext run --config web-ext-config.js",
    "web-ext:lint": "web-ext lint --config web-ext-config.js",
    "web-ext:build": "web-ext build --config web-ext-config.js",
    "package:firefox": "bun run build && bun run web-ext:build",
    "package:chrome": "bun run build:chrome && cd dist-chrome && zip -r ../extenote-clipper-chrome.zip ."
  },
  "dependencies": {
    "@extenote/refcheck": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "web-ext": "^8.4.0"
  }
}
